rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /kyc/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('(image/.*|audio/.*|video/.*)');
    }

    match /pickup/{orderId}/{fileName} {
      function orderParticipant() {
        let order = firestore.get(/databases/(default)/documents/orders/$(orderId));
        return signedIn() && (
          order.data.customerId == request.auth.uid
          || order.data.runnerId == request.auth.uid
          || admin()
        );
      }
      function assignedRunnerAtVendor() {
        let order = firestore.get(/databases/(default)/documents/orders/$(orderId));
        return signedIn()
          && request.auth.token.runnerApproved == true
          && order.data.runnerId == request.auth.uid
          && order.data.status == 'at_vendor';
      }
      allow read: if orderParticipant();
      allow write: if assignedRunnerAtVendor() && resource == null
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
